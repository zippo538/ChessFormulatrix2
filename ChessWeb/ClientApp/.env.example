# Kosongkan untuk memakai proxy Vite (/api/chess).
VITE_CHESS_API_URL=/api/chess

# Alamat backend ASP.NET ketika menjalankan `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:5239

# Hanya diperlukan jika enum PieceType dari API dikirim sebagai angka.
# Urutan harus mengikuti deklarasi enum PieceType pada backend.
VITE_PIECE_ENUM_ORDER=Pawn,Knight,Bishop,Rook,Queen,King
